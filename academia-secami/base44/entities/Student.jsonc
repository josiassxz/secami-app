{
  "name": "Student",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "full_name": {
      "type": "string",
      "title": "Nome Completo"
    },
    "cpf": {
      "type": "string",
      "title": "CPF"
    },
    "password": {
      "type": "string",
      "title": "Senha"
    },
    "matricula": {
      "type": "string",
      "title": "N\u00famero de Matr\u00edcula"
    },
    "weight": {
      "type": "number",
      "title": "Peso (kg)"
    },
    "height": {
      "type": "number",
      "title": "Altura (cm)"
    },
    "goal": {
      "type": "string",
      "title": "Objetivo"
    },
    "student_type": {
      "type": "string",
      "title": "Tipo de Aluno",
      "enum": [
        "Civil",
        "Militar"
      ],
      "default": "Civil"
    },
    "phone": {
      "type": "string",
      "title": "Telefone"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "title": "Data de Nascimento"
    },
    "active": {
      "type": "boolean",
      "title": "Ativo",
      "default": true
    },
    "photo_url": {
      "type": "string",
      "title": "Foto"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "department": {
      "type": "string",
      "title": "Secretaria / \u00d3rg\u00e3o"
    },
    "atestado_numero": {
      "type": "string",
      "title": "N\u00famero do Atestado M\u00e9dico"
    },
    "atestado_data": {
      "type": "string",
      "format": "date",
      "title": "Data do Atestado M\u00e9dico"
    }
  },
  "required": [
    "full_name",
    "cpf",
    "student_type",
    "birth_date"
  ]
}