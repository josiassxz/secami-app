# Backend SECAMI (Spring Boot + LDAP). Quando definido, o app usa a API REST
# em vez do Supabase (SPEC §10). Ex.: https://api.secami.goias.gov.br
API_BASE_URL=

# --- Legado Supabase (mantido durante a transicao) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Pagina de agradecimento que recebe o link de confirmacao de e-mail.
# HTML estatico hospedado no Vercel (Supabase serve HTML como text/plain no
# supabase.co, entao nao da pra hospedar a pagina la). Ex.:
# https://seu-projeto.vercel.app/auth-callback
# Tem que estar na allow-list de Redirect URLs do Supabase (Auth > URL Config).
# Vazio = usa reps://auth-callback (so abre se o app nativo estiver instalado).
AUTH_REDIRECT_URL=
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
